     "name": "API Keys",
     "description": "API key management operations"
    }
   ],
   "paths": {
    "/management/apikey": {
     "post": {
      "summary": "Create API key",
      "description": "Creates a new API key",
      "operationId": "createApiKey",
      "tags": [
       "API Keys"
      ],
      "requestBody": {
       "content": {
        "application/json": {
         "schema": {
          "$ref": "#/components/schemas/ApiKeyCreateRequest"
         }
        }
       },
       "required": true
      },
      "responses": {
       "200": {
        "description": "Successful operation",
        "content": {
         "application/json": {
          "schema": {
           "$ref": "#/components/schemas/ApiKeyCreateResponse"
          }
         }
        }
       },
       "400": {
        "$ref": "#/components/responses/BadRequest"
       },
       "401": {
        "$ref": "#/components/responses/Unauthorized"
       },
       "500": {
        "$ref": "#/components/responses/InternalServerError"
       }
      }
     }
    }
   },
   "components": {
    "schemas": {
     "ApiKeyCreateRequest": {
      "type": "object",
      "properties": {
       "applicationId": {
        "type": "string",
        "description": "ID of the application that will use the API key"
       },
       "description": {
        "type": "string",
        "description": "Description of the API key"
       }
      },
      "required": [
       "applicationId",
       "description"
      ]
     },
     "ApiKeyCreateResponse": {
      "type": "object",
      "properties": {
       "apiKeyId": {
        "type": "string",
        "description": "ID of the created API key"
       },
       "apiKey": {
        "type": "string",
        "description": "The API key value (only shown once at creation time)"
       }
      },
      "required": [
       "apiKeyId",
       "apiKey"
      ]
     },
     "Error": {
      "type": "object",
      "properties": {
       "code": {
        "type": "string",
        "description": "Error code"
       },
       "message": {
        "type": "string",
        "description": "Error message"
       },
       "details": {
        "type": "object",
        "description": "Additional error details"
       }
      },
      "required": [
       "code",
       "message"
      ]
     }
    },
    "responses": {
     "BadRequest": {
      "description": "Bad request",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "Unauthorized": {
      "description": "Unauthorized",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
